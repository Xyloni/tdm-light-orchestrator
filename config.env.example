# Переопределения поверх config.json. Скопируйте в config.env и заполните.
# Приоритет: переменные окружения ОС > config.env > config.json

TARGET_GAME=Hunt: Showdown 1896
# Full reward names, case-insensitive. Empty value disables exclusions.
IGNORED_DROP_NAMES=Hunt White
CLIENT_ID=kd1unb4b3q4t58fwlpcbzcbnm76a8fp

# Leave BOT_PLATFORM empty for the first-launch choice (existing Telegram settings are adopted).
# telegram | discord | none
BOT_PLATFORM=
DISCORD_BOT_TOKEN=
DISCORD_ADMIN_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

ACCOUNTS_FILE=account.txt
# Beacon interval (minimum 60 seconds). HLS is checked separately every 20 seconds.
HEARTBEAT_INTERVAL_SEC=60
CAMPAIGN_POLL_INTERVAL_SEC=120
JITTER_SEC=20
# Groups run until all available rewards are finished; legacy GROUP_SESSION_MINUTES is ignored.
LOG_DIR=logs
USE_PUBSUB=false

# One combined file: LOG_DIR/tdm-light.log (append, no rotation).
SINGLE_LOG=true
# Enable HTTP phase timings and runtime metrics during testing only.
DIAGNOSTICS=false

# Exit after consecutive complete passes with no available farming.
STOP_WHEN_IDLE=false
IDLE_CHECK_ROUNDS=3
